{
  "name": "proto-bridge-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node tools/third-party-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint 'src/**/*.css' && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "node tools/run-e2e.mjs",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "verify": "node tools/verify-open-source.mjs && node tools/secret-scan.mjs && node tools/third-party-notices.mjs --check",
    "sbom": "node tools/sbom.mjs",
    "rename": "node tools/rename-project.mjs",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "licenses": "node tools/third-party-notices.mjs --check",
    "licenses:release": "node tools/third-party-notices.mjs --check --release",
    "audit:dependencies": "node tools/audit-dependencies.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "4.2.6",
    "axios": "1.20.0",
    "dayjs": "1.11.13",
    "fflate": "0.8.3",
    "jsencrypt": "3.5.4",
    "pinia": "3.0.3",
    "vue": "3.5.42",
    "vue-i18n": "11.4.14",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.13.9",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "stylelint": "16.24.0",
    "stylelint-config-standard": "39.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.0.8"
  },
  "pnpm": {
    "overrides": {
      "ant-design-vue@4.2.6>dom-scroll-into-view": "-",
      "@vue/test-utils@2.4.6>js-beautify": "-",
      "eslint@10.14.0>minimatch": "11.0.1",
      "@eslint/config-array@0.23.5>minimatch": "11.0.1",
      "@typescript-eslint/typescript-estree@8.72.1>minimatch": "11.0.1",
      "follow-redirects": "1.16.2",
      "fast-uri": "3.1.9"
    }
  }
}
